{
  "expo": {
    "name": "Kick Drops",
    "slug": "kick-drops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kick-drops",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e0e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wisdomwizzy.kickdrops",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "audio"]
      }
    },
    "android": {
      "package": "com.wisdomwizzy.kickdrops",
      "backgroundColor": "#0e0e0e"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      ["expo-router", { "origin": "https://replit.com/" }],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#53FC18",
          "sounds": ["./assets/sounds/alarm.wav"]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "10d5df06-a08c-477a-a9be-48a622c285fb"
      }
    }
  }
}
